{
  "info": {
    "_postman_id": "a0f158f7-f2cb-431e-a54d-1673dff186df",
    "name": "RapidGo Serverless API",
    "description": "Colección de Postman para el backend serverless de RapidGo. Incluye las rutas para registrar un pedido, consultar historial y actualizar el estado, como fue definido en la arquitectura C4 y el caso de estudio.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Pedidos",
      "description": "Endpoints relacionados con la gestión de pedidos",
      "id": "12798466-3927-4225-b078-213c3eb08def",
      "item": [
        {
          "name": "1. Registrar Pedido (registrarPedido)",
          "id": "a2e5d6a2-46e3-44b8-952c-e35343bbf572",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Ocp-Apim-Subscription-Key",
                "value": "{{subscriptionKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"12345\",\n  \"items\": [\n    {\n      \"productoId\": \"A001\",\n      \"cantidad\": 2\n    }\n  ],\n  \"direccion\": \"Calle 123 #45-67\",\n  \"metodoPago\": \"tarjeta\"\n}"
            },
            "url": "{{baseUrl}}/pedidos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response contains pedidoId\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('pedidoId');",
                  "    pm.expect(jsonData.mensaje).to.eql(\"Pedido registrado exitosamente\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "2. Consultar Historial (consultarHistorial)",
          "id": "8c4290d2-bd16-404f-9226-de6785c1b36f",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Ocp-Apim-Subscription-Key",
                "value": "{{subscriptionKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/pedidos?clienteId=12345"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is an array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "3a. Actualizar Estado (Solo Estado)",
          "id": "bd042a40-a363-4612-ae6d-167384b98054",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Ocp-Apim-Subscription-Key",
                "value": "{{subscriptionKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"en camino\",\n  \"repartidorId\": \"R-999\"\n}"
            },
            "url": "{{baseUrl}}/pedidos/:id"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Verify update message\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.mensaje).to.include(\"notificación enviada\");",
                  "    pm.expect(jsonData.notificado).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "3b. Subir Evidencia (Estado + Imagen)",
          "id": "e3b8b1a4-1234-4a5b-8c6d-9e0f1a2b3c4d",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Ocp-Apim-Subscription-Key",
                "value": "{{subscriptionKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"entregado\",\n  \"repartidorId\": \"R-999\",\n  \"evidenciaBase64\": \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==\"\n}"
            },
            "url": "{{baseUrl}}/pedidos/:id"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Verify upload message\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.mensaje).to.include(\"notificación enviada\");",
                  "    pm.expect(jsonData.urlEvidencia).to.not.be.null;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwtToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generación automática de JWT para pruebas de API Management",
          "var header = {",
          "    \"alg\": \"HS256\",",
          "    \"typ\": \"JWT\"",
          "};",
          "var payload = {",
          "    \"sub\": \"12345\",",
          "    \"name\": \"RapidGo Test User\",",
          "    \"exp\": Math.floor(Date.now() / 1000) + 3600 // Expira en 1 hora",
          "};",
          "var secret = pm.collectionVariables.get(\"jwtSecret\") || pm.environment.get(\"jwtSecret\");",
          "",
          "// Función para codificar en Base64URL sin usar rstrip manual (Postman native)",
          "function base64url(source) {",
          "    var encodedSource = CryptoJS.enc.Base64.stringify(source);",
          "    var res = encodedSource.split('=')[0]; // Remove padding",
          "    res = res.replace(/\\+/g, '-');",
          "    res = res.replace(/\\//g, '_');",
          "    return res;",
          "}",
          "",
          "var encodedHeader = base64url(CryptoJS.enc.Utf8.parse(JSON.stringify(header)));",
          "var encodedPayload = base64url(CryptoJS.enc.Utf8.parse(JSON.stringify(payload)));",
          "var signature = CryptoJS.HmacSHA256(encodedHeader + \".\" + encodedPayload, secret);",
          "var encodedSignature = base64url(signature);",
          "",
          "var jwt = encodedHeader + \".\" + encodedPayload + \".\" + encodedSignature;",
          "pm.collectionVariables.set(\"jwtToken\", jwt);",
          "console.log(\"JWT generado:\", jwt);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://apim-rapidgo-gateway.azure-api.net/api",
      "description": "URL base de Azure API Management"
    },
    {
      "key": "jwtSecret",
      "value": "jwt_secret_dummy",
      "description": "Secreto utilizado para firmar el token JWT. Debe coincidir con la política de APIM."
    },
    {
      "key": "jwtToken",
      "value": "",
      "description": "El token JWT que se auto-genera mediante el script Pre-request"
    },
    {
      "key": "subscriptionKey",
      "value": "80820f490cf742cc87e85681cbd84a96",
      "description": "Llave de suscripción del producto RapidGo en APIM"
    }
  ]
}
