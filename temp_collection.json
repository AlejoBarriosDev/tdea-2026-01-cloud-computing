          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "var id = pm.response.json().pedidoId;",
              "pm.collectionVariables.set(\"lastPedidoId\", id);",
              "console.log(\"[RAPIDGO] PedidoId:\", id);"
