  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwtToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generación automática de JWT para pruebas de API Management",
          "var header = { \"alg\": \"HS256\", \"typ\": \"JWT\" };",
          "var payload = { \"sub\": \"12345\", \"name\": \"RapidGo Test User\", \"exp\": Math.floor(Date.now() / 1000) + 3600 };",
          "var secret = pm.collectionVariables.get(\"jwtSecret\") || \"jwt_secret_dummy\";",
          "function base64url(source) {",
          "    var encodedSource = CryptoJS.enc.Base64.stringify(source);",
          "    var res = encodedSource.split('=')[0];",
          "    return res.replace(/\\+/g, '-').replace(/\\//g, '_');",
          "}",
          "var encodedHeader = base64url(CryptoJS.enc.Utf8.parse(JSON.stringify(header)));",
          "var encodedPayload = base64url(CryptoJS.enc.Utf8.parse(JSON.stringify(payload)));",
          "var signature = CryptoJS.HmacSHA256(encodedHeader + \".\" + encodedPayload, secret);",
          "var jwt = encodedHeader + \".\" + encodedPayload + \".\" + base64url(signature);",
          "pm.collectionVariables.set(\"jwtToken\", jwt);"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "console.log(`[RAPIDGO] Executed: ${pm.info.requestName} - Status: ${pm.response.code}`);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://apim-rapidgo-gateway.azure-api.net/api"
    },
    {
      "key": "jwtSecret",
